{
  "name": "datacenter-operator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "dc-operator": "dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:web": "vite build --config web/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json",
    "test": "npm run build && npm run build:web && node --test \"dist/tests/**/*.test.js\"",
    "certify": "npm run build && npm run build:web && node --test \"dist/tests/certification/**/*.test.js\""
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "hash-wasm": "4.12.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "22.18.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "playwright-core": "^1.64.1",
    "typescript": "5.9.2",
    "vite": "^8.3.5"
  }
}
